generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  chats        Chat[]
  documents    Document[]
}

model Chat {
  id         String    @id @default(cuid())
  title      String    @default("新对话")
  titleAuto  Boolean   @default(true)
  messageSeq Int       @default(0)
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  documents  Document[]

  @@index([userId, updatedAt])
}

model Message {
  id          String      @id @default(cuid())
  chatId      String
  role        MessageRole
  content     String
  createdAt   DateTime    @default(now())
  clientId    String?
  position    Int         @default(0)
  // 联网搜索来源（[{ index, title, url }]），用于前端渲染可点击引用
  sources     Json?
  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  attachments Document[]

  @@unique([chatId, clientId])
  @@unique([chatId, position])
}

model Document {
  id          String          @id @default(cuid())
  name        String
  content     String
  mimeType    String?
  size        Int?
  kind        DocumentKind    @default(TEXT)
  ocrText     String?
  ocrProvider String?
  contentHash String?
  status      DocumentStatus  @default(PROCESSING)
  failedChunks  Int           @default(0)
  error       String?
  userId      String
  chatId      String?
  messageId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat        Chat?           @relation(fields: [chatId], references: [id], onDelete: SetNull)
  message     Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  chunks      DocumentChunk[]

  @@unique([userId, contentHash])
  @@index([userId, createdAt])
  @@index([chatId])
  @@index([messageId])
}



model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
  PARTIAL
}

enum DocumentKind {
  TEXT
  IMAGE
}
