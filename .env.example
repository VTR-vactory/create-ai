# ===== 数据库 =====
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/create_ai"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/create_ai"

# ===== Auth =====
AUTH_SECRET="run-openssl-rand-base64-32-and-replace-me"
AUTH_TRUST_HOST="true"

# ===== 智谱 AI =====
ZHIPU_API_KEY="your-zhipu-api-key"
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_OCR_MODEL="glm-4.6v-flash"

# ===== Redis（限流）=====
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ===== 联网搜索（可选；不填时联网开关会降级为“无结果”）=====
TAVILY_API_KEY="your-tavily-api-key"
